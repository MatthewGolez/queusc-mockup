# Copy this file to .env and fill it in. Never commit .env.

# Database, from the Databases page on webadmin.dcism.org.
# On the DCISM server the host is localhost and the port is 3306.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=username_queusc
DB_USER=username_queusc
DB_PASSWORD=change-me

# Port for the app. Use the port assigned to your subdomain, or pass it with -p.
PORT=3000

# Password given to the sample students by `npm run db:setup`.
SEED_PASSWORD=change-me-too
